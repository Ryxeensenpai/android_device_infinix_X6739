# FM Radio
ro.fm.band=1
ro.fm.chip=0x6631
ro.fm.fake_chan_0=9210 -205
ro.fm.fake_chan_1=9600 -152
ro.fm.fake_chan_2=10400 -152
ro.fm.fake_chan_3=10750 -205
ro.fm.fake_chans=4
ro.fm.high_band=1080
ro.fm.low_band=875
ro.fm.max_scan_num=40
ro.fm.noise_floor_detect=true
ro.fm.rssi_th_l2=-102
ro.fm.scan_sort=0
ro.fm.seek_lev=4
ro.fm.seek_space=1
ro.fm.short_ana_sup=1

# Perf Anim
persist.sys.activity_anim_perf_override=true

# RKP
remote_provisioning.hostname=remoteprovisioning.googleapis.com

# About Phone
ro.mist.display=1080 x 2400, 120 hz
ro.mist.battery=5000mah
ro.mist.soc=Mediatek Dimensity 8050
ro.mist.camera=108MP + 2MP + 2MP
ro.mist.front=32MP
ro.mist.platform=MT6893_T/CZA
ro.mist.screen=6.67" AMOLED
ro.mist.device.name=Infinix GT 10 Pro
